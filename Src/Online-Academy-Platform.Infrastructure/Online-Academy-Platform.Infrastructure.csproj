    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Online-Academy-Platform.Domain\Online-Academy-Platform.Domain.csproj" />
